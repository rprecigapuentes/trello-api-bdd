{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@core": ["../core/index.ts"],
      "@core/*": ["../core/*"]
    }
  },
  "include": [
    "steps/**/*.ts",
    "playwright.config.ts",
    "../core/**/*.ts",
    "fixtures/fixtures.ts",
    "api/clients/trelloClient.ts",
    "support/hooks.ts"
  ],
  "exclude": ["node_modules", "tests"]
}
